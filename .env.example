# ChainSight environment configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in values. Never commit `.env`.
# All provider credentials are read by the backend only; nothing here is exposed to the browser.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + PostGIS + TimescaleDB)
# ---------------------------------------------------------------------------
POSTGRES_USER=chainsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chainsight
POSTGRES_PORT=5432
# Used by the API/worker/migrations. Inside Docker Compose the host is `db`.
DATABASE_URL=postgresql+psycopg://chainsight:change-me@localhost:5432/chainsight
# Separate database for integration tests (it is dropped and recreated by the tests).
TEST_DATABASE_URL=postgresql+psycopg://chainsight:change-me@localhost:5432/chainsight_test

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Server-side URL the Next.js server uses to proxy /api/v1/* to FastAPI.
API_INTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AIS — Phase 2 (https://aisstream.io)
# ---------------------------------------------------------------------------
# disabled | aisstream | replay
AIS_PROVIDER=disabled
AISSTREAM_API_KEY=
AIS_REPLAY_FILE=

# ---------------------------------------------------------------------------
# Weather — Phase 2 (https://open-meteo.com). Free tier needs no key (non-commercial use).
# ---------------------------------------------------------------------------
OPEN_METEO_API_KEY=

# ---------------------------------------------------------------------------
# Carrier APIs — Phase 3. Leave blank if you do not have access;
# the platform falls back to mock/CSV data and reports the integration status.
# ---------------------------------------------------------------------------
MAERSK_CONSUMER_KEY=
MAERSK_CONSUMER_SECRET=
HAPAG_LLOYD_CLIENT_ID=
HAPAG_LLOYD_CLIENT_SECRET=
CMA_CGM_API_KEY=
DHL_API_KEY=

# ---------------------------------------------------------------------------
# Research data — Phase 5
# ---------------------------------------------------------------------------
UN_COMTRADE_API_KEY=
FRED_API_KEY=
EIA_API_KEY=

# ---------------------------------------------------------------------------
# ML — Phase 4
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=file:./mlruns
