# ChainSight environment configuration — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in values. Never commit `.env`.
# All provider credentials are read by the backend only; nothing here is exposed to the browser.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
API_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + PostGIS + TimescaleDB)
# ---------------------------------------------------------------------------
POSTGRES_USER=chainsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chainsight
POSTGRES_PORT=5432
# Used by the API/worker/migrations. Inside Docker Compose the host is `db`.
DATABASE_URL=postgresql+psycopg://chainsight:change-me@localhost:5432/chainsight
# Separate database for integration tests (it is dropped and recreated by the tests).
TEST_DATABASE_URL=postgresql+psycopg://chainsight:change-me@localhost:5432/chainsight_test

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Server-side URL the Next.js server uses to proxy /api/v1/* to FastAPI.
API_INTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AIS — Phase 2 (https://aisstream.io)
# ---------------------------------------------------------------------------
# simulator = synthetic demo traffic (labeled "Synthetic" in the UI; no key needed)
# aisstream = live AIS (requires AISSTREAM_API_KEY) | replay = play back a recording
# disabled  = no AIS ingestion
AIS_PROVIDER=simulator
AISSTREAM_API_KEY=
# JSON list of [[lat1, lon1], [lat2, lon2]] boxes for AISStream; empty = whole world
AIS_BOUNDING_BOXES=
# Append raw AISStream messages to this NDJSON file (for later historical replay)
AIS_RECORD_FILE=
AIS_REPLAY_FILE=
AIS_REPLAY_SPEED=1.0
AIS_SIMULATOR_VESSELS=24
AIS_SIMULATOR_INTERVAL_SECONDS=30

# Port registry / geofences
PORT_GEOFENCE_RADIUS_M=8000

# ---------------------------------------------------------------------------
# Weather — Phase 2 (https://open-meteo.com). Free tier needs no key (non-commercial use).
# ---------------------------------------------------------------------------
OPEN_METEO_API_KEY=
# Extra ports to always collect weather for (comma-separated UN/LOCODEs)
WEATHER_PORT_UNLOCODES=NLRTM,SGSIN,CNSHG,USLGB
WEATHER_MAX_PORTS=50

# Browser WebSocket endpoint for live positions (defaults to ws://<host>:8000/api/v1/ws/positions)
NEXT_PUBLIC_LIVE_WS_URL=

# ---------------------------------------------------------------------------
# Carrier APIs — Phase 3. Leave blank if you do not have access;
# the platform falls back to mock/CSV data and reports the integration status.
# ---------------------------------------------------------------------------
MAERSK_CONSUMER_KEY=
MAERSK_CONSUMER_SECRET=
HAPAG_LLOYD_CLIENT_ID=
HAPAG_LLOYD_CLIENT_SECRET=
CMA_CGM_API_KEY=
DHL_API_KEY=

# ---------------------------------------------------------------------------
# Research data — Phase 5
# ---------------------------------------------------------------------------
UN_COMTRADE_API_KEY=
# Optional: without a key, FRED's public CSV download is used.
FRED_API_KEY=
EIA_API_KEY=
# PortWatch port ids (comma-separated); empty = the a priori default universe.
RESEARCH_PORTWATCH_PORTS=
# FRED series ids; empty = Brent, WTI, Henry Hub.
RESEARCH_FRED_SERIES=
RESEARCH_HISTORY_START=2019-01-01

# ---------------------------------------------------------------------------
# ML — Phase 4
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db

# ---------------------------------------------------------------------------
# Authentication — Phase 6
# ---------------------------------------------------------------------------
# Required in production (>= 32 chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset in development = an ephemeral secret (everyone is signed out when the API restarts).
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=14
# Secure cookies require HTTPS; defaults to true when APP_ENV=production.
AUTH_COOKIE_SECURE=
# First owner, created at startup only if there are no users. Or run:
#   docker compose run --rm api python -m services.auth create-user --email you@example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Rate limits (per minute, Redis-backed; fail open if Redis is down)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Number of reverse proxies in front of the API whose X-Forwarded-For can be trusted.
TRUSTED_PROXY_COUNT=0

# Carrier push webhooks: {"<carrier code>": "<shared secret>"} (HMAC-SHA256, see docs)
CARRIER_WEBHOOK_SECRETS=
WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Observability — Phase 6
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
# Bearer token for /metrics (recommended unless the API is on a private network)
METRICS_TOKEN=
# OpenTelemetry tracing: set to an OTLP/HTTP endpoint, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=chainsight-api
