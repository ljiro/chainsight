# Copy to the repository root as .env.production (never commit it) and fill in every value.
CHAINSIGHT_DOMAIN=chainsight.example.com
ACME_EMAIL=ops@example.com
GHCR_OWNER=ljiro
CHAINSIGHT_VERSION=0.1.0

POSTGRES_USER=chainsight
POSTGRES_DB=chainsight
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# First owner (created once, only if there are no users); remove after the first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

API_WORKERS=2
WORKER_CONCURRENCY=2
BACKUP_HOST_DIR=/var/backups/chainsight
BACKUP_AT=02:30

# Providers (optional; see the root .env.example for all settings)
AIS_PROVIDER=aisstream
AISSTREAM_API_KEY=
FRED_API_KEY=
CARRIER_DCSA_CONFIG=
CARRIER_WEBHOOK_SECRETS=
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Monitoring (--profile monitoring). Grafana/Prometheus/Alertmanager bind to 127.0.0.1 only.
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d
# At least one alert receiver; see infrastructure/monitoring/alertmanager/entrypoint.sh
ALERT_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
